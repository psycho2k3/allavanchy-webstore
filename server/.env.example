PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Keep this at 1 on Vercel unless your database provider explicitly recommends otherwise.
DB_POOL_MAX=1
JWT_SECRET=replace_with_a_long_random_secret
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CONTACT_EMAIL_USER=your_gmail_address
CONTACT_EMAIL_APP_PASSWORD=your_gmail_app_password
CONTACT_RECEIVER_EMAIL=where_contact_messages_are_sent
# Order pricing (the storefront reads these from the API)
# Flat shipping fee per order, in PAYSTACK_CURRENCY
SHIPPING_FLAT_FEE=0
# Tax as a decimal, e.g. 0.0825 = 8.25%
TAX_RATE=0.0825

# Paystack (https://dashboard.paystack.com/#/settings/developers)
# Use the sk_test_ key while testing, then switch to sk_live_.
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
# Must be a currency your Paystack account is enabled for.
PAYSTACK_CURRENCY=USD
# Storefront URL; Paystack returns customers to CLIENT_URL/payment/callback
CLIENT_URL=http://localhost:5173
