PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Keep this at 1 on Vercel unless your database provider explicitly recommends otherwise.
DB_POOL_MAX=1
JWT_SECRET=replace_with_a_long_random_secret
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CONTACT_EMAIL_USER=your_gmail_address
CONTACT_EMAIL_APP_PASSWORD=your_gmail_app_password
CONTACT_RECEIVER_EMAIL=where_contact_messages_are_sent
